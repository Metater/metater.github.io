---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const structuredData = games.map((game) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.data.title,
  description: game.data.summary,
  url: game.data.steamUrl,
  author: game.data.developer,
  publisher: game.data.publisher,
  gamePlatform: 'Windows'
}));
---

<BaseLayout title="Steam Games" description="Released and upcoming Steam games developed or published by Metater and Connor Myers." structuredData={structuredData}>
  <section class="hero">
    <div class="shell">
      <div class="hero__eyebrow"><span class="kicker">Products for players</span><span>Steam</span></div>
      <div class="hero__grid">
        <div>
          <h1>Games built around one strong, strange idea.</h1>
          <p class="lead">Released collaborations and independent experiments in multiplayer systems, physical comedy, voice interaction, and controlled chaos.</p>
        </div>
        <aside class="hero__aside">
          <span class="meta-label">Catalog</span>
          <p>Three titles. Two released collaborations. One independent project in development.</p>
          <p>Each listing links to its authoritative Steam page.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell game-list">
      {games.map((game, index) => (
        <article class="game-feature">
          <div class="game-feature__image"><img src={game.data.image} alt={game.data.imageAlt} width="616" height="353" loading={index === 0 ? 'eager' : 'lazy'} /></div>
          <div>
            <span class="section-number">0{index + 1} / {game.data.status}</span>
            <h2>{game.data.title}</h2>
            <p class="lead">{game.data.summary}</p>
            <div class="game-feature__facts">
              <div><span>Release</span><strong>{game.data.releaseDate}</strong></div>
              <div><span>Developer</span><strong>{game.data.developer}</strong></div>
              <div><span>Publisher</span><strong>{game.data.publisher}</strong></div>
              <div><span>Credit</span><strong>{game.data.roles[0]}</strong></div>
            </div>
            {game.data.metrics.length > 0 && (
              <div class="metric-row">
                {game.id === 'airport-security-sucks' && (
                  <div class="metric-row__item" data-steam-player-count aria-live="polite">
                    <strong data-steam-player-count-value>—</strong>
                    <span data-steam-player-count-label>checking players online now</span>
                  </div>
                )}
                {game.data.metrics.map((metric) => <div class="metric-row__item"><strong>{metric.value}</strong><span>{metric.label} · {metric.asOf}</span></div>)}
              </div>
            )}
            <ul class="tag-list">{game.data.technologies.map((item) => <li>{item}</li>)}</ul>
            <div class="button-row"><a class="button button--primary" href={game.data.steamUrl}>View on Steam</a></div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script>
    const counter = document.querySelector('[data-steam-player-count]');
    if (counter) {
      const value = counter.querySelector('[data-steam-player-count-value]');
      const label = counter.querySelector('[data-steam-player-count-label]');
      const canonicalHosts = new Set(['metater.net', 'www.metater.net']);
      const endpoint = canonicalHosts.has(window.location.hostname)
        ? '/api/steam-current-players'
        : 'https://metater.net/api/steam-current-players';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 8000);

      fetch(endpoint, { headers: { Accept: 'application/json' }, signal: controller.signal })
        .then((response) => {
          if (!response.ok) throw new Error(`Player count returned ${response.status}`);
          return response.json();
        })
        .then((data) => {
          const count = data?.response?.player_count;
          if (data?.response?.result !== 1 || !Number.isInteger(count) || count < 0) {
            throw new Error('Invalid player count');
          }
          if (value) value.textContent = new Intl.NumberFormat().format(count);
          if (label) label.textContent = count === 1 ? 'player online now · Steam live' : 'players online now · Steam live';
        })
        .catch(() => {
          if (value) value.textContent = '—';
          if (label) label.textContent = 'live player count unavailable';
        })
        .finally(() => window.clearTimeout(timeout));
    }
  </script>
</BaseLayout>
