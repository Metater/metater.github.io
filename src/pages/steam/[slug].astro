---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SteamPlayerCount from '../../components/SteamPlayerCount.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

interface Props { game: CollectionEntry<'games'>; }
const { game } = Astro.props;
const data = game.data;
const gameData = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: data.title,
  description: data.summary,
  image: new URL(data.image, Astro.site),
  url: new URL(`/steam/${game.id}/`, Astro.site),
  sameAs: data.steamUrl,
  author: data.developer,
  publisher: data.publisher,
  gamePlatform: 'Windows'
};
---

<BaseLayout title={data.title} description={data.summary} image={data.image} structuredData={gameData}>
  <article>
    <header class="game-detail-hero">
      <img class="game-detail-hero__image" src={data.heroImage} alt={data.heroImageAlt} width="1920" height="620" fetchpriority="high" />
      <div class="game-detail-hero__shade"></div>
      <div class="shell game-detail-hero__content">
        <a class="game-detail-hero__back" href="/steam/">← Steam catalog</a>
        <div class="case-hero__meta"><span>{data.status}</span><span>{data.studio}</span><span>{data.releaseDate}</span></div>
        <h1>{data.title}</h1>
        <p class="lead">{data.tagline}</p>
        <div class="button-row"><a class="button button--primary" href={data.steamUrl}>View on Steam</a><a class="button button--quiet" href="#gameplay">See the game</a></div>
      </div>
    </header>

    <section class="section section--tight">
      <div class="shell game-detail-intro">
        <div>
          <span class="section-number">01 / The game</span>
          <h2>Built around a mechanic you can explain in one sentence.</h2>
        </div>
        <div>
          <p class="lead">{data.overview}</p>
          <dl class="game-detail-facts">
            <div><dt>Developer</dt><dd>{data.developer}</dd></div>
            <div><dt>Publisher</dt><dd>{data.publisher}</dd></div>
            <div><dt>Studio</dt><dd>{data.studio}</dd></div>
            <div><dt>Release</dt><dd>{data.releaseDate}</dd></div>
          </dl>
        </div>
      </div>
    </section>

    {(data.metrics.length > 0 || game.id === 'airport-security-sucks') && (
      <section class="section section--tight game-detail-metrics" aria-label={`${data.title} metrics`}>
        <div class="shell">
          <span class="section-number">02 / At a glance</span>
          <div class="metric-row metric-row--detail">
            {game.id === 'airport-security-sucks' && <SteamPlayerCount />}
            {data.metrics.map((metric) => <div class="metric-row__item"><strong>{metric.value}</strong><span>{metric.label}{metric.asOf && ` · ${metric.asOf}`}</span></div>)}
          </div>
          <p class="metric-note">Static figures are creator-supplied snapshots. The current-player figure is loaded live from Steam when available.</p>
        </div>
      </section>
    )}

    <section class="section" id="gameplay">
      <div class="shell">
        <div class="section-heading">
          <div><span class="section-number">03 / Design</span><h2 class="section-title">The systems behind the premise.</h2></div>
          <p>{data.roles.join(' · ')}</p>
        </div>
        <div class="game-pillars">
          {data.highlights.map((highlight, index) => (
            <article class="game-pillar"><span>0{index + 1}</span><h3>{highlight.title}</h3><p>{highlight.description}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section game-gallery-section">
      <div class="shell">
        <div class="section-heading">
          <div><span class="section-number">04 / In game</span><h2 class="section-title">See the idea in motion.</h2></div>
          <p>Official Steam page artwork and gameplay captures.</p>
        </div>
        <div class="game-gallery">
          {data.gallery.map((image, index) => <figure class:list={['game-gallery__item', index === 0 && 'game-gallery__item--lead']}><img src={image.src} alt={image.alt} width="1440" height="810" loading="lazy" /></figure>)}
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="shell studio-band">
        <div><span class="section-number">05 / Studio</span><h2>{data.studio}</h2></div>
        <div><p class="lead">{data.studioNote}</p><ul class="tag-list">{data.technologies.map((technology) => <li>{technology}</li>)}</ul></div>
      </div>
    </section>
  </article>
</BaseLayout>
