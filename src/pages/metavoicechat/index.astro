---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GitHubRepoStats from '../../components/GitHubRepoStats.astro';

const adopters = (await getCollection('adopters')).sort((a, b) => a.data.order - b.data.order);
const productData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'MetaVoiceChat',
  description: 'Self-contained proximity voice chat for Unity with support for multiple networking libraries.',
  codeRepository: 'https://github.com/Metater/MetaVoiceChat',
  license: 'https://opensource.org/license/mit',
  programmingLanguage: 'C#',
  author: { '@type': 'Person', name: 'Connor Myers' }
};
const features = [
  ['Network-agnostic', 'Use a supported adapter or implement a small provider interface instead of rebuilding the audio system for each networking stack.'],
  ['Jitter-aware playback', 'Dynamic buffering and latency correction smooth packet timing while preserving responsive voice communication.'],
  ['Modular audio pipeline', 'Composable inputs, outputs, and filters make push-to-talk, visualization, recording, and custom processing practical.'],
  ['Runtime-minded', 'Pooled data buffers, configurable Opus settings, diagnostics, and test signals support real multiplayer workloads.']
];
---

<BaseLayout
  title="MetaVoiceChat"
  description="Open-source, self-contained proximity voice chat for Unity with Mirror, FishNet, Netcode for GameObjects, and Netick integrations."
  structuredData={productData}
>
  <section class="hero">
    <div class="shell">
      <div class="hero__eyebrow"><span class="kicker">Open-source Unity infrastructure</span><span>MIT licensed</span></div>
      <div class="hero__grid">
        <div>
          <h1>Voice chat that fits the game you are already building.</h1>
          <p class="lead">MetaVoiceChat is a self-contained, extensible voice system for Unity—without a required cloud service or networking-vendor lock-in.</p>
          <div class="button-row">
            <a class="button button--primary" href="https://github.com/Metater/MetaVoiceChat">View on GitHub</a>
            <a class="button button--quiet" href="https://github.com/Metater/MetaVoiceChat/releases">Get the latest release</a>
          </div>
        </div>
        <aside class="hero__aside">
          <span class="meta-label">Designed for</span>
          <p>Proximity chat, team voice, positional audio, custom audio inputs, and game-specific processing pipelines.</p>
          <span class="meta-label">Built by</span>
          <p>Connor Myers / Metater</p>
        </aside>
      </div>
    </div>
  </section>

  <GitHubRepoStats />

  <section class="proof-band" aria-labelledby="mvc-reach">
    <div class="shell proof-band__inner">
      <div class="proof-band__metric">
        <span class="kicker">Selected game reach</span>
        <strong>6M+</strong>
      </div>
      <div class="proof-band__copy">
        <h2 id="mvc-reach">Proven beyond the sample scene.</h2>
        <p class="lead">Known games using MetaVoiceChat have collectively reached more than six million players.</p>
        <p>Rounded creator-supplied audience figures as of July 2026. This is aggregate game reach, not direct downloads or a claim of active users.</p>
      </div>
    </div>
  </section>

  <section class="section" id="adopters">
    <div class="shell">
      <div class="section-heading">
        <div><span class="section-number">03 / In use</span><h2 class="section-title">Selected games and projects.</h2></div>
        <p>Publicly known examples—not an exhaustive customer list. Embedded game assemblies make many integrations difficult to discover.</p>
      </div>
      <div class="adopter-grid">
        {adopters.map((adopter) => (
          <a class:list={['adopter-card', adopter.data.type === 'open-source' && 'adopter-card--opensource']} href={adopter.data.url}>
            {adopter.data.image && <div class:list={['adopter-card__image', adopter.data.type === 'open-source' && 'adopter-card__image--contain']}><img src={adopter.data.image} alt={adopter.data.imageAlt ?? ''} width="616" height="353" loading="lazy" /></div>}
            <div class="adopter-card__body">
              {adopter.data.reach && <span class="adopter-card__reach">{adopter.data.reach}</span>}
              <h3>{adopter.data.title}</h3>
              <p>{adopter.data.relationship}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="callout">Reach figures are rounded, creator-supplied snapshots as of July 2026. Follow each title for its current public information.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><span class="section-number">01 / System</span><h2 class="section-title">Enough structure to ship. Enough access to extend.</h2></div>
        <p>The defaults handle common voice-chat needs; the abstractions remain available when a project needs something unusual.</p>
      </div>
      <div class="feature-list">
        {features.map(([title, description], index) => (
          <article class="feature-item">
            <span class="feature-item__number">0{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      <div class="section-heading">
        <div><span class="section-number">02 / Integrations</span><h2 class="section-title">Bring your network.</h2></div>
        <p>Networking providers are deliberately separated from capture, codec, and playback behavior.</p>
      </div>
      <div class="integration-strip" aria-label="Supported networking integrations">
        <span>Mirror</span><span>FishNet</span><span>Netcode for GameObjects</span><span>Netick</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell contact-grid">
      <div>
        <span class="section-number">04 / Start building</span>
        <h2>Open source, inspectable, and ready to adapt.</h2>
      </div>
      <div>
        <ol class="editorial-list">
          <li>Download the latest Unity package from GitHub Releases.</li>
          <li>Add MetaVc with an input, output, and supported network provider.</li>
          <li>Follow the tutorial for positional audio, settings, and optional noise suppression.</li>
        </ol>
        <div class="button-row">
          <a class="button button--primary" href="https://github.com/Metater/MetaVoiceChat#installation">Installation</a>
          <a class="button button--quiet" href="https://youtu.be/2fSqSAnRS5M">Video tutorial</a>
          <a class="button button--quiet" href="https://discord.gg/k4ZtGAA2Nt">Support</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
